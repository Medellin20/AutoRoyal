# Laurent Crash Autos - configuration locale
# Supabase Data API. Copiez ces valeurs depuis le tableau de bord du projet.
NEXT_PUBLIC_SUPABASE_URL="https://PROJECT_REF.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY=""
# Cle privilegiee: serveur uniquement, ne jamais la prefixer avec NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=""

# NextAuth
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET=""

# Site
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Utilise par npm run admin:create pour creer le premier compte administrateur.
ADMIN_EMAIL=""
ADMIN_PASSWORD=""
ADMIN_NAME="Laurent Crash Autos"

# Alertes de commandes par e-mail (Resend).
RESEND_API_KEY=""
RESEND_FROM_EMAIL=""
ORDER_ALERT_EMAIL=""

# Cloudinary (optionnel, requis pour televerser les photos depuis l'administration)
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""
CLOUDINARY_UPLOAD_FOLDER="laurent-crash-autos/vehicules"
