# Exemple de fichier d'environnement pour AutoRoyal
# Copier ce fichier en .env et remplir les valeurs avant de lancer le projet :
# cp .env.example .env

# -------------------------
# Base de données (PostgreSQL)
# -------------------------
# Prisma dans ce projet utilise PostgreSQL. Remplacez les valeurs entre < >.
# Format recommandé :
# DATABASE_URL="postgresql://<USER>:<PASSWORD>@<HOST>:<PORT>/<DATABASE>?schema=public"
# Exemple local :
# DATABASE_URL="postgresql://postgres:password@localhost:5432/autoroyal?schema=public"

# Variables utilisées par docker-compose (optionnelles, utiles pour le démarrage local)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=password
POSTGRES_DB=autoroyal
POSTGRES_PORT=5432
ADMINER_PORT=8080
POSTGRES_HOST=db

# Attention : si votre mot de passe contient des caractères spéciaux, pensez à les encoder
# ou à entourer la valeur entière par des guillemets.

# -------------------------
# Autres variables utiles (optionnelles)
# -------------------------
# NEXTAUTH_SECRET: secret pour next-auth (déploiement)
# NEXT_PUBLIC_SITE_URL: url publique du site, utilisée pour sitemap/robots
# NEXT_PUBLIC_SITE_URL="https://example.com"
# NEXTAUTH_SECRET="une-chaîne-longue-et-secrète"

# Exemple minimal :
# DATABASE_URL="postgresql://postgres:password@localhost:5432/autoroyal?schema=public"
