# Laurent Crash Autos - configuration locale
# Remplacez PROJECT_REF, PASSWORD, POOLER_HOST et REGION avec les donnees du tableau de bord Supabase.

# Prisma Client: pooler Supavisor en mode transaction (port 6543), adapte aux fonctions serverless.
DATABASE_URL="postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1&sslmode=require"

# Prisma Migrate: connexion directe Supabase (ou pooler en mode session, port 5432, sur reseau IPv4).
DIRECT_URL="postgresql://postgres:PASSWORD@db.PROJECT_REF.supabase.co:5432/postgres?sslmode=require"

# Supabase Data API. Copier les valeurs du tableau de bord Supabase > Settings > API Keys.
NEXT_PUBLIC_SUPABASE_URL="https://PROJECT_REF.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY=""
# Cle privilegiee: serveur uniquement, ne jamais la prefixer avec NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=""

# NextAuth
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET=""

# Site
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# A definir avant npm run db:seed. Le seed efface les donnees avant de recharger la demo.
ADMIN_EMAIL=""
ADMIN_PASSWORD=""
ADMIN_NAME="Laurent Crash Autos"

# Cloudinary (optionnel, requis pour televerser les photos depuis l'administration)
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""
CLOUDINARY_UPLOAD_FOLDER="laurent-crash-autos/vehicules"
