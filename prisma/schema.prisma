generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------- Enums

enum Role {
  SUPER_ADMIN
  ADMIN
  MANAGER
}

enum OfferType {
  SALE
  RENT
  BOTH
}

enum VehicleStatus {
  AVAILABLE
  RESERVED
  RENTED
  SOLD
  MAINTENANCE
}

enum Fuel {
  ESSENCE
  DIESEL
  HYBRIDE
  ELECTRIQUE
  GPL
}

enum Transmission {
  MANUELLE
  AUTOMATIQUE
}

enum Category {
  BERLINE
  SUV
  CITADINE
  PICKUP
  UTILITAIRE
  MONOSPACE
  COUPE
  LUXE
}

enum ReservationStatus {
  PENDING
  CONFIRMED
  REFUSED
  CANCELLED
  ONGOING
  COMPLETED
}

enum PurchaseStatus {
  NEW
  IN_PROGRESS
  NEGOTIATION
  CLOSED
  REFUSED
}

enum PaymentMethod {
  CASH
  VIREMENT
  MOBILE_MONEY
  FINANCEMENT
}

// ---------------------------------------------------------------- Modeles

model User {
  id           String    @id @default(cuid())
  name         String
  email        String    @unique
  passwordHash String
  role         Role      @default(MANAGER)
  active       Boolean   @default(true)
  lastLoginAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  auditLogs AuditLog[]
  favorites Favorite[]

  @@index([role])
}

model Vehicle {
  id        String        @id @default(cuid())
  reference String        @unique
  slug      String        @unique
  brand     String
  model     String
  version   String?
  category  Category
  year      Int
  offerType OfferType     @default(BOTH)
  status    VehicleStatus @default(AVAILABLE)

  salePrice    Decimal? @db.Decimal(12, 2)
  dailyPrice   Decimal? @db.Decimal(12, 2)
  weeklyPrice  Decimal? @db.Decimal(12, 2)
  monthlyPrice Decimal? @db.Decimal(12, 2)
  deposit      Decimal? @db.Decimal(12, 2)

  mileage      Int
  fuel         Fuel
  transmission Transmission
  color        String
  seats        Int          @default(5)
  doors        Int          @default(5)
  power        Int
  vin          String?

  description       String   @db.Text
  features          String[] @default([])
  rentalConditions  String?  @db.Text
  requiredDocuments String[] @default([])

  featured    Boolean   @default(false)
  published   Boolean   @default(false)
  publishedAt DateTime?
  views       Int       @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  images           VehicleImage[]
  reservations     Reservation[]
  purchaseRequests PurchaseRequest[]
  favorites        Favorite[]

  @@index([brand, model])
  @@index([status, published])
  @@index([offerType])
  @@index([featured])
}

model VehicleImage {
  id        String   @id @default(cuid())
  vehicleId String
  url       String
  publicId  String?
  alt       String
  isMain    Boolean  @default(false)
  position  Int      @default(0)
  createdAt DateTime @default(now())

  vehicle Vehicle @relation(fields: [vehicleId], references: [id], onDelete: Cascade)

  @@index([vehicleId, position])
}

model Customer {
  id        String   @id @default(cuid())
  fullName  String
  email     String
  phone     String
  address   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  reservations     Reservation[]
  purchaseRequests PurchaseRequest[]

  @@unique([email, phone])
  @@index([email])
}

model Reservation {
  id           String            @id @default(cuid())
  reference    String            @unique
  vehicleId    String
  customerId   String
  startDate    DateTime
  endDate      DateTime
  pickupPlace  String
  returnPlace  String
  days         Int
  totalPrice   Decimal           @db.Decimal(12, 2)
  extraFees    Decimal           @default(0) @db.Decimal(12, 2)
  message      String?           @db.Text
  internalNote String?           @db.Text
  status       ReservationStatus @default(PENDING)
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt

  vehicle  Vehicle  @relation(fields: [vehicleId], references: [id], onDelete: Restrict)
  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([vehicleId, startDate, endDate])
  @@index([status])
}

model PurchaseRequest {
  id           String         @id @default(cuid())
  reference    String         @unique
  vehicleId    String
  customerId   String
  budget       Decimal?       @db.Decimal(12, 2)
  payment      PaymentMethod  @default(CASH)
  financing    Boolean        @default(false)
  tradeIn      Boolean        @default(false)
  tradeInInfo  String?
  message      String?        @db.Text
  internalNote String?        @db.Text
  status       PurchaseStatus @default(NEW)
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  vehicle  Vehicle  @relation(fields: [vehicleId], references: [id], onDelete: Restrict)
  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([status])
}

model Favorite {
  id        String   @id @default(cuid())
  vehicleId String
  userId    String?
  sessionId String?
  createdAt DateTime @default(now())

  vehicle Vehicle @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  user    User?   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([vehicleId, userId])
  @@unique([vehicleId, sessionId])
}

model ContactMessage {
  id        String   @id @default(cuid())
  fullName  String
  email     String
  phone     String?
  subject   String
  message   String   @db.Text
  handled   Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([handled])
}

model SiteSetting {
  id          String   @id @default("default")
  garageName  String   @default("AutoRoyal")
  tagline     String?
  phone       String?
  whatsapp    String?
  email       String?
  address     String?
  mapUrl      String?
  facebook    String?
  instagram   String?
  tiktok      String?
  linkedin    String?
  accentColor String   @default("#2F5BEA")
  updatedAt   DateTime @updatedAt
}

model AuditLog {
  id        String   @id @default(cuid())
  userId    String?
  userEmail String
  action    String
  entity    String
  entityId  String?
  metadata  Json?
  ip        String?
  createdAt DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([action])
  @@index([createdAt])
}

model LoginAttempt {
  id        String   @id @default(cuid())
  email     String
  ip        String
  success   Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([email, createdAt])
  @@index([ip, createdAt])
}
